.screen { position: absolute; left: 0; top: 0; right: 0; bottom: 0; color: rgb(244, 232, 207); }
.brand-card { position: absolute; left: 28px; top: 28px; width: 330px; padding: 16px 18px; background-color: rgba(14, 10, 9, 0.82); border-left-width: 3px; border-left-color: rgb(240, 132, 38); border-radius: 12px; }
.brand-row { flex-direction: row; align-items: center; }
.sigil { width: 68px; height: 68px; background-image: url("../Art/UI/EarthSigil.png"); -unity-background-scale-mode: scale-to-fit; margin-right: 14px; }
.brand-copy { flex-grow: 1; }
.eyebrow { font-size: 22px; -unity-font-style: bold; letter-spacing: 3px; color: rgb(255, 185, 75); }
.subtitle { margin-top: 2px; font-size: 11px; color: rgb(190, 171, 145); letter-spacing: 1px; }
.rule { height: 1px; margin-top: 12px; margin-bottom: 9px; background-color: rgba(236, 157, 65, 0.28); }
.stat-row { flex-direction: row; justify-content: space-between; margin-top: 3px; }
.stat-key { font-size: 9px; letter-spacing: 2px; color: rgb(139, 119, 98); }
.stat-value { font-size: 11px; -unity-font-style: bold; color: rgb(245, 214, 157); }
.meter-row { flex-direction: row; align-items: center; margin-top: 7px; }
.meter-key { width: 48px; font-size: 8px; letter-spacing: 1px; color: rgb(139, 119, 98); }
.meter-track { height: 7px; flex-grow: 1; background-color: rgba(255, 255, 255, 0.08); border-radius: 4px; overflow: hidden; }
.meter-fill { height: 7px; width: 0%; border-radius: 4px; }
.amount-fill { background-color: rgb(185, 111, 48); }
.charge-fill { background-color: rgb(255, 190, 63); }
.lift-fill { background-color: rgb(226, 134, 58); }
.landing-fill { background-color: rgb(123, 214, 176); }
.reticle { position: absolute; left: 50%; top: 50%; width: 22px; height: 22px; border-width: 1px; border-color: rgba(255, 196, 92, 0.55); border-radius: 11px; align-items: center; justify-content: center; }
.reticle--invalid { border-color: rgba(140, 140, 140, 0.38); opacity: 0.55; }
.reticle--source { border-color: rgba(232, 174, 83, 0.78); }
.reticle--ambiguous { border-color: rgba(255, 122, 70, 0.95); }
.reticle--valid { border-color: rgb(255, 218, 126); border-width: 2px; }
.reticle-dot { width: 4px; height: 4px; background-color: rgb(255, 216, 126); border-radius: 2px; }
.ability-dock { position: absolute; left: 50%; bottom: 28px; margin-left: -490px; width: 980px; flex-direction: row; justify-content: center; }
.ability-card { width: 180px; min-height: 72px; padding: 10px 12px; margin-left: 5px; margin-right: 5px; background-color: rgba(16, 12, 10, 0.78); border-bottom-width: 2px; border-bottom-color: rgba(255, 151, 46, 0.72); border-radius: 9px; }
.verb-tag { position: absolute; right: 9px; top: 8px; min-width: 34px; height: 20px; padding-left: 5px; padding-right: 5px; -unity-text-align: middle-center; background-color: rgba(255, 181, 74, 0.15); border-radius: 5px; color: rgb(255, 192, 96); -unity-font-style: bold; font-size: 8px; }
.ability-name { font-size: 12px; -unity-font-style: bold; letter-spacing: 1px; color: rgb(245, 222, 185); }
.ability-help { margin-top: 5px; font-size: 9px; color: rgb(151, 132, 111); }
.controls-card { position: absolute; right: 28px; top: 28px; width: 300px; padding: 14px 16px; background-color: rgba(11, 14, 19, 0.76); border-radius: 10px; }
.control-line { font-size: 9px; letter-spacing: 1px; color: rgb(156, 164, 174); margin-bottom: 5px; }
.control-line.strong { color: rgb(255, 185, 78); }
.status { margin-top: 8px; padding-top: 8px; border-top-width: 1px; border-top-color: rgba(255, 255, 255, 0.08); font-size: 10px; color: rgb(190, 173, 146); white-space: normal; }
