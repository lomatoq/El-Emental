.hud-shell {
    position: absolute;
    left: 24px;
    top: 24px;
    width: 430px;
    padding: 18px 20px;
    background-color: rgba(7, 15, 25, 0.88);
    border-left-width: 4px;
    border-left-color: rgb(62, 214, 255);
    border-radius: 8px;
    color: rgb(225, 244, 255);
}

.hud-title {
    font-size: 22px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    color: rgb(104, 225, 255);
    margin-bottom: 6px;
}

.hud-help {
    font-size: 11px;
    color: rgb(145, 174, 194);
    margin-bottom: 12px;
}

.telemetry-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.hud-key {
    width: 82px;
    font-size: 10px;
    color: rgb(105, 140, 164);
    margin-bottom: 5px;
}

.hud-value {
    width: 295px;
    font-size: 12px;
    color: rgb(235, 248, 255);
    margin-bottom: 5px;
}
