.cap-shell { position: absolute; left: 24px; top: 24px; width: 480px; padding: 18px; background-color: rgba(4, 19, 20, 0.92); border-left-width: 4px; border-left-color: rgb(71, 245, 201); border-radius: 8px; color: rgb(218, 255, 246); }
.title { font-size: 22px; -unity-font-style: bold; letter-spacing: 3px; color: rgb(92, 255, 215); }
.profile { font-size: 13px; margin-top: 7px; margin-bottom: 8px; color: rgb(144, 255, 227); }
.line { font-size: 11px; margin-bottom: 4px; }
.telemetry { font-size: 10px; color: rgb(126, 173, 163); margin-top: 4px; }
.hint { font-size: 10px; color: rgb(99, 149, 139); margin-top: 9px; }
