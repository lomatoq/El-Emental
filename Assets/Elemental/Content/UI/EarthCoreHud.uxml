<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="EarthCoreHud.uss" />
    <ui:VisualElement class="screen">
        <ui:VisualElement class="brand-card">
            <ui:VisualElement class="brand-row">
                <ui:VisualElement class="sigil" />
                <ui:VisualElement class="brand-copy">
                    <ui:Label text="EARTH CORE" class="eyebrow" />
                    <ui:Label text="Shape the little world" class="subtitle" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="rule" />
            <ui:VisualElement class="stat-row">
                <ui:Label text="BEND SESSION" class="stat-key" />
                <ui:Label name="ability-value" text="IDLE / AIM" class="stat-value" />
            </ui:VisualElement>
            <ui:VisualElement class="stat-row">
                <ui:Label text="CASTS" class="stat-key" />
                <ui:Label name="casts-value" text="00" class="stat-value" />
            </ui:VisualElement>
            <ui:VisualElement class="stat-row">
                <ui:Label text="MASS" class="stat-key" />
                <ui:Label name="mass-value" text="NO ROCK HELD" class="stat-value" />
            </ui:VisualElement>
            <ui:VisualElement class="stat-row">
                <ui:Label text="RESULT" class="stat-key" />
                <ui:Label name="result-value" text="READY" class="stat-value" />
            </ui:VisualElement>
            <ui:VisualElement class="stat-row">
                <ui:Label text="WHEEL" class="stat-key" />
                <ui:Label name="parameter-value" text="FORM SCALE  0%" class="stat-value" />
            </ui:VisualElement>
            <ui:VisualElement class="meter-row"><ui:Label text="FORM" class="meter-key" /><ui:VisualElement class="meter-track"><ui:VisualElement name="amount-fill" class="meter-fill amount-fill" /></ui:VisualElement></ui:VisualElement>
            <ui:VisualElement class="meter-row"><ui:Label text="POWER" class="meter-key" /><ui:VisualElement class="meter-track"><ui:VisualElement name="charge-fill" class="meter-fill charge-fill" /></ui:VisualElement></ui:VisualElement>
            <ui:VisualElement class="meter-row"><ui:Label text="LIFT" class="meter-key" /><ui:VisualElement class="meter-track"><ui:VisualElement name="lift-fill" class="meter-fill lift-fill" /></ui:VisualElement></ui:VisualElement>
            <ui:VisualElement class="meter-row"><ui:Label text="LAND" class="meter-key" /><ui:VisualElement class="meter-track"><ui:VisualElement name="landing-fill" class="meter-fill landing-fill" /></ui:VisualElement></ui:VisualElement>
            <ui:VisualElement class="meter-row"><ui:Label text="GRAV" class="meter-key" /><ui:VisualElement class="meter-track"><ui:VisualElement name="gravity-fill" class="meter-fill charge-fill" /></ui:VisualElement></ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="aim-reticle" class="reticle">
            <ui:VisualElement class="reticle-dot" />
        </ui:VisualElement>

        <ui:VisualElement class="ability-dock">
            <ui:VisualElement class="ability-card"><ui:Label text="LMB ON ROCK" class="verb-tag" /><ui:Label text="GRIP STONE" class="ability-name" /><ui:Label text="Aim at any loose stone" class="ability-help" /></ui:VisualElement>
            <ui:VisualElement class="ability-card"><ui:Label text="DRAG LMB" class="verb-tag" /><ui:Label text="WALL / PLATFORM" class="ability-name" /><ui:Label text="Straight line or closed curved outline" class="ability-help" /></ui:VisualElement>
            <ui:VisualElement class="ability-card"><ui:Label text="MOVE" class="verb-tag" /><ui:Label text="LIFT + CONTROL" class="ability-name" /><ui:Label text="Move after forming the rock" class="ability-help" /></ui:VisualElement>
            <ui:VisualElement class="ability-card"><ui:Label text="RMB" class="verb-tag" /><ui:Label text="VECTOR FIELD" class="ability-name" /><ui:Label text="Hold to accelerate, release to punch" class="ability-help" /></ui:VisualElement>
            <ui:VisualElement class="ability-card"><ui:Label text="MMB" class="verb-tag" /><ui:Label text="GRAVITY GRIP" class="ability-name" /><ui:Label text="Pull shards; hold on structures to fracture" class="ability-help" /></ui:VisualElement>
            <ui:VisualElement class="ability-card"><ui:Label text="SHIFT + SPACE" class="verb-tag" /><ui:Label text="PILLAR WAVE" class="ability-name" /><ui:Label text="Shift widens sector, Space adds power" class="ability-help" /></ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement class="controls-card">
            <ui:Label text="FREE MOUSE  AIM + DRAW     A / D  TURN" class="control-line" />
            <ui:Label text="W / S  FORWARD / BACK     CAMERA FOLLOWS" class="control-line" />
            <ui:Label text="HOLD SPACE  CHARGE EARTH PILLAR LAUNCH" class="control-line strong" />
            <ui:Label text="HOLD SHIFT THEN SPACE  WIDEN + POWER PILLAR WAVE" class="control-line strong" />
            <ui:Label text="WHILE FALLING HOLD SPACE  LANDING CUSHION" class="control-line strong" />
            <ui:Label text="LMB  GRIP / FORM / MOVE / RELEASE" class="control-line strong" />
            <ui:Label text="RMB  VECTOR FORCE / CHARGE" class="control-line strong" />
            <ui:Label text="MMB  GRAVITY GRIP / FRACTURE EARTH" class="control-line strong" />
            <ui:Label text="WHEEL  HOLD DISTANCE / PLATFORM HEIGHT" class="control-line" />
            <ui:Label name="status-value" text="Earth responds continuously to shape, mass and momentum." class="status" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
