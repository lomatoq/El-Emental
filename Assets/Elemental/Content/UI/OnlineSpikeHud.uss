.net-shell { position: absolute; left: 24px; bottom: 24px; width: 390px; padding: 16px; background-color: rgba(8, 10, 24, 0.9); border-bottom-width: 3px; border-bottom-color: rgb(144, 99, 255); border-radius: 8px; color: rgb(230, 225, 255); }
.title { font-size: 20px; -unity-font-style: bold; letter-spacing: 2px; color: rgb(175, 142, 255); margin-bottom: 8px; }
.line { font-size: 12px; margin-bottom: 3px; }
.hint { font-size: 10px; margin-top: 7px; color: rgb(135, 126, 171); }
