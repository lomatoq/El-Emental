.mission-shell {
    position: absolute;
    right: 24px;
    top: 24px;
    width: 440px;
    padding: 18px;
    background-color: rgba(22, 10, 9, 0.9);
    border-top-width: 3px;
    border-top-color: rgb(255, 93, 38);
    border-radius: 8px;
    color: rgb(255, 235, 220);
}
.title { font-size: 22px; -unity-font-style: bold; letter-spacing: 2px; color: rgb(255, 125, 63); }
.status { font-size: 13px; margin-top: 8px; margin-bottom: 8px; }
.line { font-size: 12px; color: rgb(242, 204, 174); margin-bottom: 3px; }
.debug { font-size: 10px; color: rgb(161, 120, 103); margin-bottom: 10px; }
.strategy-row { flex-direction: row; }
.strategy { flex-grow: 1; height: 32px; margin-right: 4px; background-color: rgb(66, 28, 22); color: rgb(255, 221, 201); border-width: 1px; border-color: rgb(115, 50, 35); }
.selected { margin-top: 7px; font-size: 11px; color: rgb(255, 154, 85); -unity-text-align: middle-right; }
