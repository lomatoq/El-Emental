  m_Script: {fileID: 11500000, guid: 833c3541f2af4b28b080abc2cd1a804d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.VisualEffectGraph.Editor::UnityEditor.VFX.Block.CustomHLSL
  m_UIIgnoredErrors: []
  m_Parent: {fileID: 114350483966675000}
  m_Children: []
  m_UIPosition: {x: 0, y: 0}
  m_UICollapsed: 0
  m_UISuperCollapsed: 0
  m_InputSlots:
  - {fileID: 114350483966675084}
  - {fileID: 114350483966675085}
  - {fileID: 114350483966675086}
  - {fileID: 114350483966675087}
  - {fileID: 114350483966675088}
  - {fileID: 114350483966675092}
  - {fileID: 114350483966675096}
  - {fileID: 114350483966675097}
  - {fileID: 114350483966675098}
  - {fileID: 114350483966675099}
  - {fileID: 114350483966675100}
  - {fileID: 114350483966675101}
  - {fileID: 114350483966675102}
  m_OutputSlots: []
  m_Disabled: 0
  m_ActivationSlot: {fileID: 114350483966675083}
  m_BlockName: Custom HLSL
  m_HLSLCode: "// Copy both files to the exact directory below, or update this include.\n#include
    \"Assets/Elemental/Presentation/Fire/Shaders/FireFieldCommon.hlsl\"\n\n// VFX
    Graph Custom HLSL block, Update context. Select EF_FireStep.\n// IMPORTANT: disable
    the Update context's automatic position integration.\n// Keep automatic age/reap
    enabled. Pass the graph's own Delta Time, not CPU dt.\nvoid EF_FireStep(inout
    VFXAttributes attributes,\n    in StructuredBuffer<float4> FireNodes, in uint
    FireNodeCount,\n    in StructuredBuffer<float4> FireContacts, in uint FireContactCount,\n   
    in float3 FireOriginWS, in float3 FireFreeUpWS,\n    in float FireDeltaTime,
    in float FireTime,\n    in float FireFreeDrag, in float FireFreeLift,\n    in
    float FireMaxSpeed, in float FireParticleRadius,\n    in uint FireSubsteps)\n{\n   
    attributes.fireAge = saturate(attributes.age / max(attributes.lifetime, 0.001));\n   
    float dt = max(FireDeltaTime, 0.0);\n    if (dt <= 0.0) return;\n    uint steps
    = clamp(FireSubsteps, 1u, 4u);\n    float h = dt / (float)steps; // Do not silently
    discard elapsed simulation time.\n    float3 p = attributes.position - FireOriginWS;\n   
    float3 v = attributes.velocity;\n    float3 freeUp = EF_Normalize(FireFreeUpWS,
    float3(0, 1, 0));\n    uint contactCount = min(FireContactCount, EF_MAX_CONTACTS);\n   
    [loop] for (uint s = 0u; s < steps; ++s)\n    {\n        float t = (float)s *
    h;\n        float3 old = p;\n        float3 target;\n        float response;\n       
    EF_SampleField(FireNodes, FireNodeCount, p,\n            FireTime - dt + t, target,
    response);\n        if (response > 0.0)\n            v = lerp(v, target, 1.0
    - exp(-response * h));\n        else\n            v = (v + freeUp * max(FireFreeLift,
    0.0) * h)\n                * exp(-max(FireFreeDrag, 0.0) * h);\n        [loop]
    for (uint j = 0u; j < contactCount; ++j)\n            EF_SteerContact(FireContacts,
    j, p, t, FireParticleRadius,\n                attributes.firePhase, h, v);\n       
    v = EF_Limit(v, max(FireMaxSpeed, 0.0));\n        p += v * h;\n        // Sequential
    projections keep separate constraints at corners.\n        // A bounded approximation,
    not exact CCD of arbitrary mesh geometry.\n        [unroll] for (uint iteration
    = 0u; iteration < 3u; ++iteration)\n            [loop] for (uint projectedContact
    = 0u; projectedContact < contactCount; ++projectedContact)\n                EF_ResolveContact(FireContacts,
    projectedContact, old, t, h,\n                    FireParticleRadius, attributes.firePhase,
    p, v);\n    }\n    attributes.position = p + FireOriginWS;\n    attributes.velocity
    = v;\n}\n\n\n"
  m_ShaderFile: {fileID: 0}
  m_AvailableFunction:
    selection: EF_FireStep
    selectedIndex: 0
