+++ b/Assets/Elemental/Runtime/Physics/EarthPlanetRockScatter.cs
@@ -57,6 +57,20 @@ public void Configure(EarthPlanetRockScatterProfile configuredProfile, VoxelPlan
             if (Application.isPlaying && isActiveAndEnabled) Begin();
         }
 
+        /// <summary>Appends stable collider sources created by the staged planet dressing pass.</summary>
+        public int AppendAuthoredFractureSources(List<Mesh> destination)
+        {
+            if (destination == null) throw new ArgumentNullException(nameof(destination));
+            int before = destination.Count;
+            if (colliderMeshes != null)
+                for (int index = 0; index < colliderMeshes.Length; index++)
+                {
+                    Mesh candidate = colliderMeshes[index];
+                    if (candidate != null && !destination.Contains(candidate)) destination.Add(candidate);
+                }
+            return destination.Count - before;
+        }
+
         private void Start() => Begin();
         private void OnEnable() { if (initialized && !completed && build == null) build = StartCoroutine(Build()); }
         private void OnDisable() { if (build != null) StopCoroutine(build); build = null; }
