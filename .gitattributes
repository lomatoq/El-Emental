* text=auto
*.cs text diff=csharp
*.shader text
*.hlsl text
*.compute text
*.uss text
*.uxml text
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.meta text eol=lf

# Large binary game assets are stored through Git LFS.
*.fbx filter=lfs diff=lfs merge=lfs -text
